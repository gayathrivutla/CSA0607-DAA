def string_matching(words):
    result = []

    for word in words:
        for other in words:
            if word != other and word in other:
                result.append(word)
                break

    return result

print(string_matching(["mass", "as", "hero", "superhero"]))
print(string_matching(["leetcode", "et", "code"]))
print(string_matching(["blue", "green", "bu"]))
